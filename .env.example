# Copy this file to .env and fill in your own keys. NEVER commit .env.

# Required for answer generation, grading and grounding checks.
GEMINI_API_KEY=your_gemini_key_here

# Optional: enables the Tavily web-search fallback. Without it the pipeline
# answers from the local corpus only (or abstains).
TAVILY_API_KEY=your_tavily_key_here

# Optional overrides (see README "Configuration"); every setting is CRAG_<NAME>.
# CRAG_TOP_K=5
# CRAG_MAX_REWRITES=2
# CRAG_WEB_SEARCH_ENABLED=true
# CRAG_LLM_MODEL=gemini-3.1-flash-lite

# LangSmith tracing sends prompts, documents and answers to a third party.
# Leave disabled unless you intend that.
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
